{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 1
    },
    "configurePresets": [
        {
            "name": "debug",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "environment": {},
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-DCFG_TUSB_DEBUG=0 -D_DEBUG_TRACE",
                "TRACE_USBPD": true
            }
        },
        {
            "name": "release",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "environment": {},
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS": "-DCFG_TUSB_DEBUG=0",
                "TRACE_USBPD": false

            }
        },
        {
            "name": "debug-tmc",
            "inherits": "debug",
            "displayName": "Debug (TMC mode)",
            "description": "Debug config for Powerboard with USBTMC",
            "cacheVariables": {
                "USB_MODE": "tmc"
            }
        },
        {
            "name": "debug-cdc",
            "inherits": "debug",
            "displayName": "Debug (CDC mode)",
            "description": "Debug config for Powerboard with CDC",
            "cacheVariables": {
                "USB_MODE": "cdc"
            }
        },
        {
            "name": "release-tmc",
            "inherits": "release",
            "displayName": "Release (TMC mode)",
            "description": "Release config for Powerblock with USBTMC",
            "cacheVariables": {
                "USB_MODE": "tmc"
            }
        },
        {
            "name": "release-cdc",
            "inherits": "release",
            "displayName": "Release (CDC mode)",
            "description": "Release config for Powerblock with CDC",
            "cacheVariables": {
                "USB_MODE": "cdc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-tmc",
            "configurePreset": "debug-tmc"
        },
        {
            "name": "debug-cdc",
            "configurePreset": "debug-cdc"
        },
        {
            "name": "release-tmc",
            "configurePreset": "release-tmc"
        },
        {
            "name": "release-cdc",
            "configurePreset": "release-cdc"
        }
    ],
    "testPresets": [],
    "vendor": {}
}
